<%- include("partials/header") %>

<main class="category-details-page">


<section class="page-header">
    <h1><%= title %></h1>

    <% if (category.description) { %>
        <p>
            <%= category.description %>
        </p>
    <% } %>
</section>

<section class="category-projects">

    <h2>Service Projects</h2>

    <% if (projects.length > 0) { %>

        <div class="projects-grid">

            <% projects.forEach(project => { %>

                <article class="project-card">

                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <% if (project.description) { %>
                        <p>
                            <%= project.description %>
                        </p>
                    <% } %>

                    <% if (project.date) { %>
                        <p>
                            <strong>Date:</strong>
                            <%= project.date %>
                        </p>
                    <% } %>

                    <% if (project.location) { %>
                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>
                    <% } %>

                    <p>
                        <strong>Partner Organization:</strong>
                        <a
                            href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                </article>

            <% }); %>

        </div>

    <% } else { %>

        <p>
            No service projects are currently assigned
            to this category.
        </p>

    <% } %>

</section>


</main>

<%- include("partials/footer") %>
