<%- include("partials/header") %>

<main>
    <div class="main-content">

        <section class="page-header">

            <h1>
                <%= category.category_name %>
            </h1>

            <p>
                Service category details
            </p>

        </section>


        <% if (success && success.length > 0) { %>

            <div
                class="success-message"
                role="status"
            >

                <% success.forEach((message) => { %>

                    <p>
                        <%= message %>
                    </p>

                <% }); %>

            </div>

        <% } %>


        <section class="category-details">

            <article class="category-card">

                <div class="category-content">

                    <h2>
                        <%= category.category_name %>
                    </h2>

                    <p>
                        <%= category.description %>
                    </p>


                    <div class="form-actions">

                        <% if (isLoggedIn && currentUser && currentUser.role === "admin") { %>

                            <a
                                href="/category/<%= category.category_id %>/edit"
                                class="button btn-primary"
                            >
                                Edit Category
                            </a>

                        <% } %>


                        <a
                            href="/categories"
                            class="button"
                        >
                            Back to Categories
                        </a>

                    </div>

                </div>

            </article>

        </section>


        <section class="category-projects">

            <div class="section-heading">

                <h2>
                    Service Projects
                </h2>

                <p>
                    Projects assigned to this category.
                </p>

            </div>


            <% if (projects && projects.length > 0) { %>

                <div class="projects-grid">

                    <% projects.forEach((project) => { %>

                        <article class="project-card">

                            <div class="project-content">

                                <h3>

                                    <a
                                        href="/project/<%= project.project_id %>"
                                        class="card-link"
                                    >
                                        <%= project.project_name %>
                                    </a>

                                </h3>


                                <p>
                                    <%= project.description %>
                                </p>


                                <p>
                                    <strong>
                                        Date:
                                    </strong>

                                    <%= new Date(project.project_date).toLocaleDateString() %>
                                </p>


                                <p>
                                    <strong>
                                        Location:
                                    </strong>

                                    <%= project.location %>
                                </p>


                                <% if (project.organization_name) { %>

                                    <p>
                                        <strong>
                                            Organization:
                                        </strong>

                                        <a
                                            href="/organization/<%= project.organization_id %>"
                                        >
                                            <%= project.organization_name %>
                                        </a>
                                    </p>

                                <% } %>


                                <div class="form-actions">

                                    <a
                                        href="/project/<%= project.project_id %>"
                                        class="button"
                                    >
                                        View Details
                                    </a>

                                </div>

                            </div>

                        </article>

                    <% }); %>

                </div>

            <% } else { %>

                <article class="card">

                    <h3>
                        No Service Projects
                    </h3>

                    <p>
                        There are currently no service projects assigned to this category.
                    </p>

                </article>

            <% } %>

        </section>

    </div>
</main>

<%- include("partials/footer") %>