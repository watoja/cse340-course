
<%- include("partials/header") %>

<main class="dashboard-page">

    <!-- =====================================================
         DASHBOARD HEADER
    ====================================================== -->

    <section class="page-header">
        <h1>Dashboard</h1>

        <p>
            Welcome back, <strong><%= name %></strong>.
        </p>

        <p>
            You are signed in as
            <strong><%= role %></strong>.
        </p>
    </section>


    <!-- =====================================================
         ACCOUNT INFORMATION
    ====================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">
            <h2>Account Information</h2>

            <p>
                View your current account information.
            </p>
        </div>

        <div class="card dashboard-account-card">

            <div class="dashboard-account-item">
                <strong>Name</strong>
                <span><%= name %></span>
            </div>

            <div class="dashboard-account-item">
                <strong>Email</strong>
                <span><%= email %></span>
            </div>

            <div class="dashboard-account-item">
                <strong>Role</strong>
                <span><%= role %></span>
            </div>

        </div>

        <div class="dashboard-actions">
            <a href="/logout" class="button">
                Log Out
            </a>
        </div>

    </section>


    <!-- =====================================================
         MY VOLUNTEER PROJECTS
         AVAILABLE TO ALL LOGGED-IN USERS
    ====================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">
            <h2>My Volunteer Projects</h2>

            <p>
                View the service projects you have signed up
                to support. You can also remove yourself from
                a project if your plans change.
            </p>
        </div>

        <% if (
            typeof volunteeredProjects !== "undefined" &&
            Array.isArray(volunteeredProjects) &&
            volunteeredProjects.length > 0
        ) { %>

            <div class="project-grid">

                <% volunteeredProjects.forEach((project) => { %>

                    <article class="project-card">

                        <div class="project-content">

                            <h3>
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.project_name %>
                                </a>
                            </h3>

                            <p>
                                <strong>Date:</strong>

                                <% if (project.project_date) { %>
                                    <%= new Date(
                                        project.project_date
                                    ).toLocaleDateString() %>
                                <% } else { %>
                                    Date not specified
                                <% } %>
                            </p>

                            <p>
                                <strong>Location:</strong>

                                <%= project.location || "Not specified" %>
                            </p>

                            <p>
                                <strong>Organization:</strong>

                                <%= project.organization_name ||
                                    "Not assigned" %>
                            </p>

                            <% if (project.signup_date) { %>

                                <p>
                                    <strong>Signed up:</strong>

                                    <%= new Date(
                                        project.signup_date
                                    ).toLocaleDateString() %>
                                </p>

                            <% } %>

                            <div class="form-actions">

                                <a
                                    href="/project/<%= project.project_id %>"
                                    class="button"
                                >
                                    View Project
                                </a>

                                <form
                                    action="/project/<%= project.project_id %>/volunteer/remove"
                                    method="POST"
                                >

                                    <input
                                        type="hidden"
                                        name="returnTo"
                                        value="dashboard"
                                    >

                                    <button
                                        type="submit"
                                        class="button"
                                    >
                                        Remove Me
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>

                <% }); %>

            </div>

        <% } else { %>

            <div class="card">

                <p>
                    You have not signed up to volunteer for
                    any service projects yet.
                </p>

                <div class="dashboard-actions">

                    <a href="/projects" class="button">
                        Explore Service Projects
                    </a>

                </div>

            </div>

        <% } %>

    </section>


    <!-- =====================================================
         ADMIN MANAGEMENT
         ONLY VISIBLE TO ADMIN USERS
    ====================================================== -->

    <% if (role === "admin") { %>

        <section class="dashboard-section admin-dashboard-section">

            <div class="section-heading">
                <h2>Administration</h2>

                <p>
                    Manage and update the content of the
                    Community Service Projects website.
                </p>
            </div>


            <!-- ORGANIZATIONS -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Organizations</h3>

                    <p>
                        View organizations and manage their
                        information.
                    </p>
                </div>

                <div class="dashboard-actions">

                    <a href="/organizations" class="button">
                        Manage Organizations
                    </a>

                    <a href="/organization/create" class="button">
                        Add Organization
                    </a>

                </div>

            </div>


            <!-- PROJECTS -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Projects</h3>

                    <p>
                        View projects, update project information,
                        and manage project categories.
                    </p>
                </div>

                <div class="dashboard-actions">

                    <a href="/projects" class="button">
                        Manage Projects
                    </a>

                    <a href="/project/create" class="button">
                        Add Project
                    </a>

                </div>

            </div>


            <!-- CATEGORIES -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Categories</h3>

                    <p>
                        View and manage the categories used to
                        organize service projects.
                    </p>
                </div>

                <div class="dashboard-actions">

                    <a href="/categories" class="button">
                        Manage Categories
                    </a>

                    <a href="/category/create" class="button">
                        Add Category
                    </a>

                </div>

            </div>


            <!-- REGISTERED USERS -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Registered Users</h3>

                    <p>
                        View registered users, their email
                        addresses, and their assigned roles.
                    </p>
                </div>

                <div class="dashboard-actions">

                    <a href="/users" class="button">
                        Manage Users
                    </a>

                </div>

            </div>

        </section>

    <% } %>


    <!-- =====================================================
         GENERAL WEBSITE NAVIGATION
    ====================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">
            <h2>Community Service Projects</h2>

            <p>
                Explore organizations, projects, and categories
                available on the website.
            </p>
        </div>

        <div class="dashboard-navigation">

            <a href="/organizations" class="button">
                View Organizations
            </a>

            <a href="/projects" class="button">
                View Projects
            </a>

            <a href="/categories" class="button">
                View Categories
            </a>

        </div>

    </section>

</main>

<%- include("partials/footer") %>
