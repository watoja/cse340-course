<%- include("partials/header") %>

<main class="dashboard-page">

    <!-- =====================================================
         DASHBOARD HEADER
    ====================================================== -->

    <section class="page-header">
        <h1>Dashboard</h1>

        <p>
            Welcome back, <strong><%= name %></strong>.
        </p>

        <p>
            You are signed in as
            <strong><%= role %></strong>.
        </p>
    </section>


    <!-- =====================================================
         ACCOUNT INFORMATION
    ====================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">
            <h2>Account Information</h2>

            <p>
                View your current account information.
            </p>
        </div>

        <div class="card dashboard-account-card">

            <div class="dashboard-account-item">
                <strong>Name</strong>

                <span><%= name %></span>
            </div>

            <div class="dashboard-account-item">
                <strong>Email</strong>

                <span><%= email %></span>
            </div>

            <div class="dashboard-account-item">
                <strong>Role</strong>

                <span><%= role %></span>
            </div>

        </div>

        <div class="dashboard-actions">
            <a href="/logout" class="button">
                Log Out
            </a>
        </div>

    </section>


    <!-- =====================================================
         MY VOLUNTEERED PROJECTS (W06 Assignment)
    ====================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">
            <h2>My Volunteered Projects</h2>

            <p>
                Projects you have signed up to volunteer for.
            </p>
        </div>

        <% if (locals.projects && projects.length > 0) { %>

            <div class="card dashboard-account-card" style="display: flex; flex-direction: column; gap: 15px;">
                <% projects.forEach(project => { %>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 10px;">
                        <div>
                            <strong>
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.project_name %>
                                </a>
                            </strong>
                            <p style="margin: 5px 0 0; font-size: 0.9rem; color: #666;">
                                <%= project.location %> — <%= new Date(project.project_date).toLocaleDateString() %>
                            </p>
                        </div>
                        <div>
                            <form action="/project/<%= project.project_id %>/volunteer" method="POST" style="margin: 0;">
                                <input type="hidden" name="action" value="remove">
                                <button type="submit" class="button button-danger" style="background-color: #d9534f; color: white; border: none; padding: 6px 12px; cursor: pointer;">
                                    Leave Project
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>

        <% } else { %>

            <p>You have not volunteered for any projects yet. <a href="/projects">Browse available projects</a> to sign up!</p>

        <% } %>

    </section>


    <!-- =====================================================
         ADMIN MANAGEMENT
         ONLY VISIBLE TO ADMIN USERS
    ====================================================== -->

    <% if (role === "admin") { %>

        <section class="dashboard-section admin-dashboard-section">

            <div class="section-heading">
                <h2>Administration</h2>

                <p>
                    Manage and update the content of the
                    Community Service Projects website.
                </p>
            </div>


            <!-- ORGANIZATIONS -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Organizations</h3>

                    <p>
                        View organizations and manage their
                        information.
                    </p>
                </div>

                <div class="dashboard-actions">
                    <a href="/organizations" class="button">
                        Manage Organizations
                    </a>

                    <a href="/organization/create" class="button">
                        Add Organization
                    </a>
                </div>

            </div>


            <!-- PROJECTS -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Projects</h3>

                    <p>
                        View projects, update project information,
                        and manage project categories.
                    </p>
                </div>

                <div class="dashboard-actions">
                    <a href="/projects" class="button">
                        Manage Projects
                    </a>

                    <a href="/project/create" class="button">
                        Add Project
                    </a>
                </div>

            </div>


            <!-- CATEGORIES -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Categories</h3>

                    <p>
                        View and manage the categories used to
                        organize service projects.
                    </p>
                </div>

                <div class="dashboard-actions">
                    <a href="/categories" class="button">
                        Manage Categories
                    </a>

                    <a href="/category/create" class="button">
                        Add Category
                    </a>
                </div>

            </div>


            <!-- REGISTERED USERS -->

            <div class="dashboard-management-card">

                <div class="dashboard-management-content">
                    <h3>Registered Users</h3>

                    <p>
                        View registered users, their email
                        addresses, and their assigned roles.
                    </p>
                </div>

                <div class="dashboard-actions">
                    <a href="/users" class="button">
                        Manage Users
                    </a>
                </div>

            </div>

        </section>

    <% } %>


    <!-- =====================================================
         GENERAL WEBSITE NAVIGATION
    ====================================================== -->

    <section class="dashboard-section">

        <div class="section-heading">
            <h2>Community Service Projects</h2>

            <p>
                Explore organizations, projects, and categories
                available on the website.
            </p>
        </div>

        <div class="dashboard-navigation">

            <a href="/organizations" class="button">
                View Organizations
            </a>

            <a href="/projects" class="button">
                View Projects
            </a>

            <a href="/categories" class="button">
                View Categories
            </a>

        </div>

    </section>

</main>

<%- include("partials/footer") %>