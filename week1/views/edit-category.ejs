<%- include("partials/header") %>

<main>
    <div class="main-content">

        <section class="page-header">

            <h1>
                Edit Category
            </h1>

            <p>
                Update the service project category.
            </p>

        </section>


        <% if (errors && errors.length > 0) { %>

            <div
                class="form-errors"
                role="alert"
            >

                <h2>
                    Please correct the following:
                </h2>

                <ul>

                    <% errors.forEach((error) => { %>

                        <li>
                            <%= error %>
                        </li>

                    <% }); %>

                </ul>

            </div>

        <% } %>


        <section class="form-section">

            <form
                action="/category/<%= category.category_id %>/edit"
                method="POST"
            >

                <div class="form-group">

                    <label for="category_name">
                        Category Name
                    </label>

                    <input
                        type="text"
                        id="category_name"
                        name="category_name"
                        class="form-control"
                        value="<%= category.category_name || '' %>"
                        minlength="2"
                        maxlength="100"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        class="form-control"
                        minlength="10"
                        maxlength="500"
                        required
                    ><%= category.description || '' %></textarea>

                </div>


                <div class="form-actions">

                    <button
                        type="submit"
                        class="button btn-primary"
                    >
                        Update Category
                    </button>

                    <a
                        href="/category/<%= category.category_id %>"
                        class="button"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </section>

    </div>
</main>

<%- include("partials/footer") %>