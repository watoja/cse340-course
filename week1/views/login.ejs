<%- include("partials/header") %>

<main class="registration-page">

    <section class="page-header">

        <h1>
            <%= title %>
        </h1>

        <p>
            Log in to your account.
        </p>

    </section>


    <% if (error) { %>

        <div
            class="error-message"
            role="alert"
        >
            <%= error %>
        </div>

    <% } %>


    <% if (success) { %>

        <div
            class="success-message"
            role="status"
        >
            <%= success %>
        </div>

    <% } %>


    <section class="form-section">

        <form
            action="/login"
            method="POST"
        >

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                >

            </div>


            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    required
                    autocomplete="current-password"
                >

            </div>


            <button type="submit">
                Login
            </button>

        </form>

    </section>

</main>

<%- include("partials/footer") %>