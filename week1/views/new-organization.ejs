<%- include("partials/header") %>

<main>
    <div class="main-content">

        <section class="page-header">

            <h1>
                Create New Organization
            </h1>

            <p>
                Add a community organization to the
                service projects directory.
            </p>

        </section>


        <% if (errors && errors.length > 0) { %>

            <div
                class="form-errors"
                role="alert"
            >

                <h2>
                    Please correct the following:
                </h2>

                <ul>

                    <% errors.forEach((error) => { %>

                        <li>
                            <%= error.msg || error %>
                        </li>

                    <% }); %>

                </ul>

            </div>

        <% } %>


        <section class="form-section">

            <form
                action="/organization/create"
                method="POST"
                class="organization-form"
            >

                <div class="form-group">

                    <label
                        for="organization_name"
                    >
                        Organization Name
                    </label>

                    <input
                        type="text"
                        id="organization_name"
                        name="organization_name"
                        value="<%= organization?.organization_name || '' %>"
                        required
                        minlength="2"
                    >

                </div>


                <div class="form-group">

                    <label
                        for="description"
                    >
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        required
                        minlength="10"
                    ><%= organization?.description || '' %></textarea>

                </div>


                <div class="form-group">

                    <label
                        for="website"
                    >
                        Website
                    </label>

                    <input
                        type="url"
                        id="website"
                        name="website"
                        value="<%= organization?.website || '' %>"
                        placeholder="https://example.com"
                    >

                </div>


                <div class="form-group">

                    <label
                        for="contact_email"
                    >
                        Contact Email
                    </label>

                    <input
                        type="email"
                        id="contact_email"
                        name="contact_email"
                        value="<%= organization?.contact_email || '' %>"
                    >

                </div>


                <div class="form-group">

                    <label
                        for="phone"
                    >
                        Phone
                    </label>

                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        value="<%= organization?.phone || '' %>"
                    >

                </div>


                <div class="form-group">

                    <label
                        for="location"
                    >
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        value="<%= organization?.location || '' %>"
                    >

                </div>


                <div class="form-actions">

                    <button
                        type="submit"
                        class="button btn-primary"
                    >
                        Create Organization
                    </button>

                    <a
                        href="/organizations"
                        class="button"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </section>

    </div>
</main>

<%- include("partials/footer") %>