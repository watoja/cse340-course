<%- include("partials/header") %>

<main>
    <div class="main-content">

        <section class="page-header">

            <h1>
                Add Project
            </h1>

            <p>
                Create a new community service project.
            </p>

        </section>


        <% if (errors && errors.length > 0) { %>

            <div
                class="form-errors"
                role="alert"
            >

                <h2>
                    Please correct the following:
                </h2>

                <ul>

                    <% errors.forEach((error) => { %>

                        <li>
                            <%= error %>
                        </li>

                    <% }); %>

                </ul>

            </div>

        <% } %>


        <section class="form-section">

            <form
                action="/project/create"
                method="POST"
                id="project-form"
                novalidate
            >

                <div class="form-group">

                    <label for="project_name">
                        Project Name
                    </label>

                    <input
                        type="text"
                        id="project_name"
                        name="project_name"
                        class="form-control"
                        value="<%= project.project_name || '' %>"
                        minlength="2"
                        maxlength="100"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="description">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        class="form-control"
                        minlength="10"
                        maxlength="1000"
                        required
                    ><%= project.description || '' %></textarea>

                </div>


                <div class="form-group">

                    <label for="project_date">
                        Project Date
                    </label>

                    <input
                        type="date"
                        id="project_date"
                        name="project_date"
                        class="form-control"
                        value="<%= project.project_date || '' %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="location">
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        class="form-control"
                        value="<%= project.location || '' %>"
                        minlength="2"
                        maxlength="200"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="volunteers_needed">
                        Volunteers Needed
                    </label>

                    <input
                        type="number"
                        id="volunteers_needed"
                        name="volunteers_needed"
                        class="form-control"
                        value="<%= project.volunteers_needed || '' %>"
                        min="1"
                        max="100000"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="organization_id">
                        Organization
                    </label>

                    <select
                        id="organization_id"
                        name="organization_id"
                        class="form-control"
                        required
                    >

                        <option value="">
                            Select an organization
                        </option>

                        <% organizations.forEach((organization) => { %>

                            <option
                                value="<%= organization.organization_id %>"
                                <%= Number(project.organization_id) === Number(organization.organization_id) ? "selected" : "" %>
                            >
                                <%= organization.organization_name %>
                            </option>

                        <% }); %>

                    </select>

                </div>


                <div class="form-actions">

                    <button
                        type="submit"
                        class="button btn-primary"
                    >
                        Create Project
                    </button>

                    <a
                        href="/projects"
                        class="button"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </section>

    </div>
</main>

<script src="/js/validation.js" defer></script>

<%- include("partials/footer") %>