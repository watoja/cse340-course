<%- include("partials/header") %>

<main>
    <div class="main-content">

        <section class="page-header">

            <h1>Organizations</h1>

            <p>
                Organizations involved in community service.
            </p>

            <div class="page-actions">
                <a
                    href="/organization/create"
                    class="button"
                >
                    Add Organization
                </a>
            </div>

        </section>

        <section class="organizations-section">

            <% if (organizations.length > 0) { %>

                <div class="organizations-grid">

                    <% organizations.forEach((organization) => { %>

                        <article class="organization-card">

                            <% if (organization.image) { %>

                                <img
                                    src="/images/<%= organization.image %>"
                                    alt="<%= organization.organization_name %>"
                                    class="organization-image"
                                    loading="lazy"
                                >

                            <% } %>

                            <div class="organization-content">

                                <h2>
                                    <%= organization.organization_name %>
                                </h2>

                                <p>
                                    <%= organization.description %>
                                </p>

                                <% if (organization.location) { %>

                                    <p>
                                        <strong>
                                            Location:
                                        </strong>

                                        <%= organization.location %>
                                    </p>

                                <% } %>

                                <a
                                    href="/organization/<%= organization.organization_id %>"
                                    class="card-link"
                                >
                                    View Organization
                                </a>

                            </div>

                        </article>

                    <% }); %>

                </div>

            <% } else { %>

                <p>
                    No organizations are currently available.
                </p>

            <% } %>

        </section>

    </div>
</main>

<%- include("partials/footer") %>