<%- include("partials/header") %>

<main class="organizations-page">

```
<section class="page-header">
    <h1><%= title %></h1>

    <p>
        Here are our partner organizations.
    </p>
</section>

<section class="organizations-grid">

    <% organizations.forEach(organization => { %>

        <article class="organization-card">

            <div class="organization-image">
                <img
                    src="/images/<%= organization.image %>"
                    alt="<%= organization.organization_name %> logo">
            </div>

            <div class="organization-content">

                <h2>
                    <a
                        href="/organization/<%= organization.organization_id %>">
                        <%= organization.organization_name %>
                    </a>
                </h2>

                <p>
                    <%= organization.description %>
                </p>

                <% if (organization.contact_email) { %>
                    <p>
                        <strong>Email:</strong>
                        <%= organization.contact_email %>
                    </p>
                <% } %>

                <% if (organization.location) { %>
                    <p>
                        <strong>Location:</strong>
                        <%= organization.location %>
                    </p>
                <% } %>

            </div>

        </article>

    <% }); %>

</section>
```

</main>

<%- include("partials/footer") %>
