<%- include("partials/header") %>

<main class="organizations-page">

    <section class="page-header">
        <h1><%= title %></h1>
        <p>
            Learn about organizations that provide opportunities
            for community service.
        </p>
    </section>

    <section class="organization-list">

        <% if (organizations && organizations.length > 0) { %>

            <div class="organization-cards">

                <% organizations.forEach(organization => { %>

                    <article class="organization-card">

                        <% if (organization.image) { %>

                            <div class="organization-image">
                                <img
                                    src="/images/<%= organization.image %>"
                                    alt="<%= organization.organization_name %>"
                                >
                            </div>

                        <% } %>

                        <div class="organization-content">

                            <h2>
                                <%= organization.organization_name %>
                            </h2>

                            <p>
                                <%= organization.description %>
                            </p>

                            <% if (organization.location) { %>
                                <p>
                                    <strong>Location:</strong>
                                    <%= organization.location %>
                                </p>
                            <% } %>

                            <% if (organization.phone) { %>
                                <p>
                                    <strong>Phone:</strong>
                                    <%= organization.phone %>
                                </p>
                            <% } %>

                            <% if (organization.contact_email) { %>
                                <p>
                                    <strong>Email:</strong>
                                    <%= organization.contact_email %>
                                </p>
                            <% } %>

                            <% if (organization.website) { %>
                                <p>
                                    <strong>Website:</strong>
                                    <a
                                        href="<%= organization.website %>"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Visit website
                                    </a>
                                </p>
                            <% } %>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } else { %>

            <p>No organizations are currently available.</p>

        <% } %>

    </section>

</main>

<%- include("partials/footer") %>