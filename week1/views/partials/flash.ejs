<% if (success && success.length > 0) { %>

    <div
        class="flash-message flash-success"
        role="status"
    >
        <% success.forEach((message) => { %>
            <p><%= message %></p>
        <% }); %>
    </div>

<% } %>


<% if (error && error.length > 0) { %>

    <div
        class="flash-message flash-error"
        role="alert"
    >
        <% error.forEach((message) => { %>
            <p><%= message %></p>
        <% }); %>
    </div>

<% } %>