
<%- include("partials/header") %>

<main>
    <div class="main-content">

        <!-- SUCCESS MESSAGES -->

        <% if (success && success.length > 0) { %>

            <div
                class="form-success"
                role="status"
            >

                <% success.forEach((message) => { %>

                    <p>
                        <%= message %>
                    </p>

                <% }); %>

            </div>

        <% } %>


        <!-- PROJECT HEADER -->

        <section class="page-header">

            <h1>
                <%= project.project_name %>
            </h1>

            <p>
                Community service project details.
            </p>

        </section>


        <!-- PROJECT DETAILS -->

        <section class="project-details">

            <article class="project-card">

                <div class="project-content">

                    <h2>
                        <%= project.project_name %>
                    </h2>

                    <p>
                        <%= project.description %>
                    </p>


                    <!-- PROJECT INFORMATION -->

                    <div class="project-information">

                        <p>
                            <strong>Date:</strong>

                            <%= new Date(
                                project.project_date
                            ).toLocaleDateString() %>
                        </p>

                        <p>
                            <strong>Location:</strong>

                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Volunteers Needed:</strong>

                            <%= project.volunteers_needed %>
                        </p>

                        <p>
                            <strong>Organization:</strong>

                            <% if (project.organization_id) { %>

                                <a
                                    href="/organization/<%= project.organization_id %>"
                                >
                                    <%= project.organization_name %>
                                </a>

                            <% } else { %>

                                Not assigned

                            <% } %>

                        </p>

                    </div>


                    <!-- ASSIGNED CATEGORIES -->

                    <section class="project-categories">

                        <h3>
                            Assigned Categories
                        </h3>

                        <% if (
                            categories &&
                            categories.length > 0
                        ) { %>

                            <ul class="category-list">

                                <% categories.forEach((category) => { %>

                                    <li>
                                        <%= category.category_name %>
                                    </li>

                                <% }); %>

                            </ul>

                        <% } else { %>

                            <p>
                                No categories have been
                                assigned to this project.
                            </p>

                        <% } %>

                    </section>


                    <!-- VOLUNTEER ACTIONS -->

                    <section class="project-volunteer-section">

                        <h3>
                            Volunteer for This Project
                        </h3>

                        <% if (isLoggedIn) { %>

                            <% if (hasVolunteered) { %>

                                <p role="status">
                                    You are volunteering for this project.
                                </p>

                                <form
                                    action="/project/<%= project.project_id %>/volunteer/remove"
                                    method="POST"
                                    class="form-actions"
                                >

                                    <button
                                        type="submit"
                                        class="button"
                                    >
                                        Remove Me as a Volunteer
                                    </button>

                                </form>

                            <% } else { %>

                                <p>
                                    Interested in helping with this
                                    service project? Sign up to volunteer.
                                </p>

                                <form
                                    action="/project/<%= project.project_id %>/volunteer"
                                    method="POST"
                                    class="form-actions"
                                >

                                    <button
                                        type="submit"
                                        class="button"
                                    >
                                        Volunteer for This Project
                                    </button>

                                </form>

                            <% } %>

                        <% } else { %>

                            <p>
                                Please log in to volunteer for this project.
                            </p>

                            <div class="form-actions">

                                <a href="/login" class="button">
                                    Log In to Volunteer
                                </a>

                                <a href="/register" class="button">
                                    Create an Account
                                </a>

                            </div>

                        <% } %>

                    </section>


                    <!-- PAGE ACTIONS -->

                    <div class="form-actions">

                        <% if (
                            isLoggedIn &&
                            currentUser &&
                            currentUser.role === "admin"
                        ) { %>

                            <a
                                href="/project/<%= project.project_id %>/edit"
                                class="button"
                            >
                                Edit Project
                            </a>

                            <a
                                href="/project/<%= project.project_id %>/categories"
                                class="button"
                            >
                                Assign Categories
                            </a>

                        <% } %>

                        <a
                            href="/projects"
                            class="button"
                        >
                            Back to Projects
                        </a>

                    </div>

                </div>

            </article>

        </section>

    </div>
</main>

<%- include("partials/footer") %>
