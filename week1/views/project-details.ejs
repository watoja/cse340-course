<%- include("partials/header") %>

<main>
    <div class="main-content">

        <section class="page-header">

            <h1>
                <%= project.project_name %>
            </h1>

            <p>
                Service project details
            </p>

        </section>


        <% if (success && success.length > 0) { %>

            <div
                class="success-message"
                role="status"
            >

                <% success.forEach((message) => { %>

                    <p>
                        <%= message %>
                    </p>

                <% }); %>

            </div>

        <% } %>


        <section class="project-details">

            <article class="project-card">

                <div class="project-content">

                    <h2>
                        <%= project.project_name %>
                    </h2>


                    <p>
                        <%= project.description %>
                    </p>


                    <p>
                        <strong>
                            Date:
                        </strong>

                        <%= new Date(project.project_date).toLocaleDateString() %>
                    </p>


                    <p>
                        <strong>
                            Location:
                        </strong>

                        <%= project.location %>
                    </p>


                    <p>
                        <strong>
                            Volunteers Needed:
                        </strong>

                        <%= project.volunteers_needed %>
                    </p>


                    <% if (project.organization_name) { %>

                        <p>
                            <strong>
                                Organization:
                            </strong>

                            <a
                                href="/organization/<%= project.organization_id %>"
                            >
                                <%= project.organization_name %>
                            </a>
                        </p>

                    <% } %>


                    <div class="form-actions">

                        <a
                            href="/project/<%= project.project_id %>/edit"
                            class="button btn-primary"
                        >
                            Edit Project
                        </a>


                        <a
                            href="/project/<%= project.project_id %>/categories"
                            class="button"
                        >
                            Assign Categories
                        </a>


                        <a
                            href="/projects"
                            class="button"
                        >
                            Back to Projects
                        </a>

                    </div>

                </div>

            </article>

        </section>

    </div>
</main>

<%- include("partials/footer") %>