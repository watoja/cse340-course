<%- include("partials/header") %>

<main>
    <div class="main-content">

        <section class="page-header">

            <h1>
                Upcoming Service Projects
            </h1>

            <p>
                Discover upcoming opportunities to serve in your community.
            </p>

            <div class="form-actions">

                <a
                    href="/project/create"
                    class="button btn-primary"
                >
                    Add Project
                </a>

            </div>

        </section>


        <% if (success && success.length > 0) { %>

            <div
                class="success-message"
                role="status"
            >

                <% success.forEach((message) => { %>

                    <p>
                        <%= message %>
                    </p>

                <% }); %>

            </div>

        <% } %>


        <% if (projects && projects.length > 0) { %>

            <section
                class="projects-grid"
                aria-label="Upcoming service projects"
            >

                <% projects.forEach((project) => { %>

                    <article class="project-card">

                        <div class="project-content">

                            <h2>

                                <a
                                    href="/project/<%= project.project_id %>"
                                    class="card-link"
                                >
                                    <%= project.project_name %>
                                </a>

                            </h2>


                            <p>
                                <%= project.description %>
                            </p>


                            <p>
                                <strong>
                                    Date:
                                </strong>

                                <%= new Date(project.project_date).toLocaleDateString() %>
                            </p>


                            <p>
                                <strong>
                                    Location:
                                </strong>

                                <%= project.location %>
                            </p>


                            <p>
                                <strong>
                                    Volunteers Needed:
                                </strong>

                                <%= project.volunteers_needed %>
                            </p>


                            <% if (project.organization_name) { %>

                                <p>
                                    <strong>
                                        Organization:
                                    </strong>

                                    <a
                                        href="/organization/<%= project.organization_id %>"
                                    >
                                        <%= project.organization_name %>
                                    </a>
                                </p>

                            <% } %>


                            <div class="form-actions">

                                <a
                                    href="/project/<%= project.project_id %>"
                                    class="button"
                                >
                                    View Details
                                </a>

                            </div>

                        </div>

                    </article>

                <% }); %>

            </section>

        <% } else { %>

            <section class="card">

                <h2>
                    No Upcoming Projects
                </h2>

                <p>
                    There are currently no upcoming service projects.
                </p>

            </section>

        <% } %>

    </div>
</main>

<%- include("partials/footer") %>