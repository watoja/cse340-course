<%- include("partials/header") %>

<main class="projects-page">


<section class="page-header">
    <h1><%= title %></h1>

    <p>
        Here are the next upcoming service projects.
    </p>
</section>

<section class="projects-grid">

    <% if (projects.length > 0) { %>

        <% projects.forEach(project => { %>

            <article class="project-card">

                <div class="project-content">

                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h2>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        <strong>Date:</strong>
                        <%= project.date %>
                    </p>

                    <% if (project.location) { %>
                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>
                    <% } %>

                    <p>
                        <strong>Partner Organization:</strong>
                        <a
                            href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                </div>

            </article>

        <% }); %>

    <% } else { %>

        <p>
            There are currently no upcoming service projects.
        </p>

    <% } %>

</section>


</main>

<%- include("partials/footer") %>
